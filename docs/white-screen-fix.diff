+def ui_file() -> Path:
+    roots = [Path(__file__).resolve().parent]
+    if getattr(sys, "frozen", False):
+        roots.insert(0, Path(sys._MEIPASS))
+    for root in roots:
+        candidate = root / "launcher_ui.html"
+        if candidate.is_file():
+            return candidate
+    raise FileNotFoundError("launcher_ui.html is missing")
