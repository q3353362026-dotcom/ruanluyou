#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10

cleanup_redirect() {
	# Only the application's private table; never flush the router's firewall.
	nft list table ip radaer_native >/dev/null 2>&1 && nft delete table ip radaer_native
	return 0
}

start_service() {
	local enabled
	config_load radaer
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	cleanup_redirect
	/usr/libexec/radaer-hnat disable || return 1
	procd_open_instance
	procd_set_param command /usr/libexec/radaer-run
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 15
	procd_set_param file /etc/config/radaer
	procd_close_instance
}

stop_service() {
	cleanup_redirect
}

service_stopped() {
	/usr/libexec/radaer-hnat enable
}

service_started() {
	local enabled
	config_load radaer
	config_get_bool enabled main enabled 1
	# A disabled configuration submits an empty procd service on reload.
	[ "$enabled" = 1 ] || /usr/libexec/radaer-hnat enable
	return 0
}

service_triggers() {
	local network
	config_load radaer
	config_get network main network lan
	procd_add_reload_trigger radaer
	procd_add_interface_trigger "interface.*" "$network" /etc/init.d/radaer restart
}
